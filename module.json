{
  "name": "game-tables",
  "displayName": "Mesas de rol",
  "version": "2.25.0",
  "repository": "DavidMRGaona/guildforge-game-tables",
  "namespace": "Modules\\GameTables",
  "provider": "GameTablesServiceProvider",
  "description": "Gestión de mesas de juegos de rol y campañas",
  "author": "GuildForge",
  "requires": {
    "core": "^3.22",
    "filament": "^5.0",
    "php": ">=8.5",
    "laravel": ">=13.0"
  },
  "storesUtc": true,
  "dependencies": [],
  "provides": {
    "permissions": [
      "gametables.view_any",
      "gametables.view",
      "gametables.create",
      "gametables.update",
      "gametables.delete",
      "campaigns.view_any",
      "campaigns.view",
      "campaigns.create",
      "campaigns.update",
      "campaigns.delete",
      "gamesystems.view_any",
      "gamesystems.manage",
      "contentwarnings.view_any",
      "contentwarnings.manage",
      "gametables.settings"
    ],
    "routes": [
      "web"
    ],
    "filament": true,
    "frontend": true,
    "inertia_share": true
  }
}
